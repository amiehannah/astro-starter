---
import Button from "./Button.astro";
---

<header>
	<div class="container">
		<h1 class="logo">LOGO</h1>
		<nav>
			<div class="off-screen-menu">
				<ul class="nav-items">
					<li><a href="" class="nav-link">Home</a></li>
					<li><a href="" class="nav-link">About</a></li>
					<li><a href="" class="nav-link">Services</a></li>
					<li>
						<a href="" class="nav-link btn btn-accent">Contact us</a>
					</li>
				</ul>
			</div>
		</nav>
		<button class="burger-button" aria-label="Toggle menu" type="button">
			<span class="burger-top"></span>
			<span class="burger-bottom"></span>
		</button>
	</div>
</header>

<style is:global>
	body:has(.burger-button.active) {
		overflow: clip;
	}
</style>

<style>
	header {
		position: relative;
		padding: 1em 0;

		&:has(.burger-button.active) {
			z-index: 1000;
			position: sticky;
			top: 0px;
		}
	}

	.container {
		display: flex;
		justify-content: space-between;
		align-items: center;
		width: 95%;
		max-width: 1000px;
		margin: 0 auto;
	}

	.logo {
		font-size: 1.5rem;
	}

	.burger-button {
		display: none;
		height: 28px;
		width: 28px;
		margin-left: auto;
		z-index: 1000;

		span {
			height: 2px;
			width: 100%;
			background-color: #192d36;
			border-radius: 25px;
			position: absolute;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			transition:
				transform 0.3s ease,
				background-color 0.3s ease;
			will-change: transform, background-color;
		}

		&.active span {
			background-color: #f4f5f5;
		}

		span:nth-child(1) {
			top: 25%;
		}

		span:nth-child(2) {
			top: 60%;
		}

		&.active span:nth-child(1) {
			top: 50%;
			transform: translate(-50%, -50%) rotate(45deg);
		}

		&.active span:nth-child(2) {
			top: 50%;
			transform: translate(-50%, -50%) rotate(-45deg);
		}
	}

	.off-screen-menu {
		display: flex;
		width: 100%;
		justify-content: flex-end;
	}

	.nav-items {
		display: flex;
		flex-direction: row;
		align-items: center;
		text-transform: uppercase;
		letter-spacing: 0.02rem;
		font-weight: 300;
	}

	.nav-link {
		padding: 0px 16px;
		font-size: 14px;
	}

	.nav-link:hover:not(.btn) {
		color: red;
		/* change the colour of this 
		could I also add a fun animation to underline the link?
		*/
	}

	nav {
		display: flex;
		background-color: white;
	}

	/* media queries */
	@media screen and (max-width: 480px) {
		.off-screen-menu {
			z-index: 1000;
			background-color: #192d36;
			color: #f4f5f5;
			height: 100vh;
			width: 100vw;
			position: fixed;
			top: 0px;
			left: 100vw;
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			text-align: center;
			font-size: 1.4rem;
			text-transform: uppercase;
			transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
			overflow-y: auto;
			will-change: transform;

			&.active {
				transform: translateX(-100vw);
				transition-duration: 600ms;
			}
		}

		.nav-items {
			display: flex;
			flex-direction: column;
			align-items: center;
			letter-spacing: 0.1rem;
			font-weight: 300;
			z-index: 1000;
			padding-bottom: 16px;
		}

		li {
			padding: 8px;
		}

		.burger-button {
			display: block;
			position: absolute;
			top: 1em;
			right: 1em;
		}
	}
</style>

<script>
	const burgerMenuButton = document.querySelector(".burger-button");
	const offScreenMenu = document.querySelector(".off-screen-menu");

	burgerMenuButton?.addEventListener("click", () => {
		burgerMenuButton.classList.toggle("active");
		offScreenMenu?.classList.toggle("active");
	});
</script>
